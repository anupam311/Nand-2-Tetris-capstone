
/**
 * Hack Memory chip.
 * Maps RAM16K, Screen and Keyboard.
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Separate RAM and I/O write signals.
    DMux(
        in=load,
        sel=address[14],
        a=loadRAM,
        b=loadIO
    );

    // Screen is selected when address[14]=1
    // and address[13]=0.
    Not(in=address[13], out=notAddress13);

    And(
        a=loadIO,
        b=notAddress13,
        out=loadScreen
    );

    // RAM: addresses 0 to 16383.
    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Screen: addresses 16384 to 24575.
    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard: address 24576.
    Keyboard(out=keyboardOut);

    // Select Screen or Keyboard.
    Mux16(
        a=screenOut,
        b=keyboardOut,
        sel=address[13],
        out=ioOut
    );

    // Select RAM or I/O.
    Mux16(
        a=ramOut,
        b=ioOut,
        sel=address[14],
        out=out
    );
}
